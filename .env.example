# Used when running services outside Docker. Compose sets its own values.
DATABASE_URL=postgres://ninja:ninja@localhost:5432/ninja
AI_SERVICE_URL=http://localhost:8001
TOKENS_FILE=../fixtures/tokens.json
KNOWLEDGE_DIR=../knowledge

# fake (default) or a real provider you add in ai-service/src/ai_service/llm.py
LLM_PROVIDER=fake
FAKE_CHUNK_DELAY_SECONDS=0.02
FAKE_SLOW_SECONDS=12
